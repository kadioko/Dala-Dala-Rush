func _ready() -> void:
	current_locale = SaveSystem.get_value("locale", "sw")

func t(key: String) -> String:
	var locale_dict: Dictionary = strings.get(current_locale, strings["sw"])
	return locale_dict.get(key, key)

func set_locale(locale: String) -> void:
	if locale == current_locale:
		return
	if not strings.has(locale):
		return
	current_locale = locale
	SaveSystem.set_value("locale", locale)
	emit_signal("locale_changed", locale)

func toggle_locale() -> void:
	set_locale("en" if current_locale == "sw" else "sw")
